{
  "manifest_version": 3,
  "name": "Social Anti-Ragebait & Emotion Predictor",
  "version": "1.1.0",
  "description": "Predicts emotional intent & automatically blurs rage-bait on X (Twitter), Threads, and Facebook using Jev",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://classifier.dev/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://threads.net/*",
    "https://www.threads.net/*",
    "https://facebook.com/*",
    "https://www.facebook.com/*",
    "https://web.facebook.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://threads.net/*",
        "https://www.threads.net/*",
        "https://facebook.com/*",
        "https://www.facebook.com/*",
        "https://web.facebook.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
