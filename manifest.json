{
  "manifest_version": 3,
  "name": "Social Shield: AI Anti-Rage & Focus Guard",
  "version": "3.0.0",
  "description": "Minimalist AI focus guard and casual feed classifier for X (Twitter) powered by classifier.dev and Gemini 3.5 Flash-Lite.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Social Shield: AI Anti-Rage & Focus Guard"
  },
  "permissions": [
    "storage",
    "tabs",
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://classifier.dev/*",
    "https://classifier.dev/",
    "https://generativelanguage.googleapis.com/*",
    "*://*.x.com/*",
    "*://x.com/*",
    "*://*.twitter.com/*",
    "*://twitter.com/*",
    "*://*.twimg.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.x.com/*",
        "*://x.com/*",
        "*://*.twitter.com/*",
        "*://twitter.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
